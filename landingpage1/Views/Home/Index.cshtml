@{
    ViewData["Title"] = "Learnly — Learn something new";
}

<section class="hero" id="top">
    <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span> A better way to learn</p>
        <h1>Small steps.<br />Big <span>possibilities.</span></h1>
        <p class="hero-description">
            Build skills you can use every day. Explore practical, bite-sized courses made for the way you live and work.
        </p>
        <div class="hero-actions">
            <a class="button button-primary" href="#courses">Explore courses <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#how-it-works">See how it works</a>
        </div>
        <div class="learner-proof">
            <div class="avatar-stack" aria-hidden="true">
                <span class="avatar avatar-one">J</span>
                <span class="avatar avatar-two">M</span>
                <span class="avatar avatar-three">A</span>
                <span class="avatar avatar-four">S</span>
            </div>
            <p><strong>12,000+</strong><br />curious minds learning</p>
        </div>
    </div>

    <div class="hero-art" aria-label="Illustration of an online lesson in progress" role="img">
        <div class="art-orbit orbit-one"></div>
        <div class="art-orbit orbit-two"></div>
        <div class="lesson-card">
            <div class="lesson-topline">
                <span class="lesson-label"><span class="live-dot"></span> YOUR NEXT LESSON</span>
                <span class="lesson-menu" aria-hidden="true">•••</span>
            </div>
            <div class="lesson-illustration">
                <div class="lesson-sun"></div>
                <div class="lesson-hill hill-back"></div>
                <div class="lesson-hill hill-front"></div>
                <div class="lesson-play" aria-hidden="true">▶</div>
            </div>
            <p class="lesson-category">DESIGN &amp; CREATIVITY</p>
            <h2>Design with confidence</h2>
            <div class="lesson-meta">
                <span>6 lessons</span>
                <span class="meta-divider"></span>
                <span>2h 15m</span>
                <span class="lesson-rating"><span aria-hidden="true">★</span> 4.9</span>
            </div>
            <div class="lesson-progress"><span></span></div>
            <div class="lesson-footer"><span>Course progress</span><strong>35%</strong></div>
        </div>
        <div class="floating-note note-top"><span class="note-icon">✦</span><span>Keep your<br /><strong>curiosity</strong></span></div>
        <div class="floating-note note-bottom"><span class="note-check">✓</span><span>One lesson<br /><strong>at a time</strong></span></div>
    </div>
</section>

<section class="trust-strip" aria-label="Learning topics">
    <p>GOOD THINGS TO LEARN</p>
    <div><span>✳</span> Creative skills</div>
    <div><span>⌘</span> Tech &amp; digital</div>
    <div><span>↗</span> Career growth</div>
    <div><span>◉</span> Everyday life</div>
</section>

<section class="courses-section" id="courses">
    <div class="section-heading">
        <div>
            <p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p>
            <h2>Find a skill that <span>moves you.</span></h2>
        </div>
        <p>Good learning fits into real life. Start with something you love, and go at your own pace.</p>
    </div>

    <div class="course-grid">
        <article class="course-card course-lilac">
            <div class="course-art art-design"><span class="design-shape shape-one"></span><span class="design-shape shape-two"></span><span class="design-shape shape-three"></span></div>
            <div class="course-info">
                <p class="course-category">CREATIVE SKILLS</p>
                <h3>Make ideas come to life</h3>
                <div class="course-details"><span>12 courses</span><a href="#how-it-works" aria-label="Explore creative skills courses">Explore <span aria-hidden="true">↗</span></a></div>
            </div>
        </article>
        <article class="course-card course-peach">
            <div class="course-art art-tech"><span class="tech-window"><i></i><i></i><i></i><b>&lt;/&gt;</b></span><span class="tech-spark">✦</span></div>
            <div class="course-info">
                <p class="course-category">TECH &amp; DIGITAL</p>
                <h3>Feel at home with tech</h3>
                <div class="course-details"><span>18 courses</span><a href="#how-it-works" aria-label="Explore tech and digital courses">Explore <span aria-hidden="true">↗</span></a></div>
            </div>
        </article>
        <article class="course-card course-mint">
            <div class="course-art art-career"><span class="career-sun"></span><span class="career-line line-one"></span><span class="career-line line-two"></span><span class="career-line line-three"></span><span class="career-arrow">↗</span></div>
            <div class="course-info">
                <p class="course-category">CAREER &amp; BUSINESS</p>
                <h3>Grow into your next role</h3>
                <div class="course-details"><span>9 courses</span><a href="#how-it-works" aria-label="Explore career and business courses">Explore <span aria-hidden="true">↗</span></a></div>
            </div>
        </article>
    </div>
</section>

<section class="how-section" id="how-it-works">
    <div class="how-intro">
        <p class="eyebrow">LEARNING, MADE HUMAN</p>
        <h2>Make room for <span>what’s next.</span></h2>
        <p>Forget the pressure to have it all figured out. Pick a topic, press play, and make progress in your own way.</p>
        <a class="button button-light" href="#courses">Find your first course <span aria-hidden="true">→</span></a>
    </div>
    <div class="how-points">
        <div class="how-point"><span class="point-number">01</span><div><h3>Start with what interests you</h3><p>Choose from practical topics and approachable courses.</p></div></div>
        <div class="how-point"><span class="point-number">02</span><div><h3>Learn in little moments</h3><p>Short lessons make it easy to fit learning into your day.</p></div></div>
        <div class="how-point"><span class="point-number">03</span><div><h3>Take your next step</h3><p>Build confidence by putting new skills into practice.</p></div></div>
    </div>
</section>
